[Unit]
Description=vjt-claude !chanstats sidecar (web chanstats + roll stats, in channel)
Documentation=https://github.com/vjt/claude-ircbot
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/vjt/code/IRC/vjt-claude
ExecStart=/usr/bin/python3 -u /home/vjt/code/IRC/vjt-claude/chanstats_sidecar.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/vjt/code/IRC/vjt-claude/chanstats.log
StandardError=inherit

[Install]
WantedBy=default.target
