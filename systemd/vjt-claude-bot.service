[Unit]
Description=vjt-claude IRC bridge bot (FIFO inbox + bot.log event stream)
Documentation=https://github.com/vjt/claude-ircbot
After=network-online.target default.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vjt/code/IRC/vjt-claude
# Egress v6 via m42 (babe:: /128 routed m42 wg1 -> golem wg -> nowhere, see
# /etc/NetworkManager/dispatcher.d/50-bot-v6): frees a slot of the home IP's
# Azzurra clone budget. PTR sono.un.llm.ma.mi.piace.la.grappa.chat.
# If the tunnel is down the bot cannot connect: accepted (vjt 2026-11-12).
Environment=IRC_BIND=2a03:4000:20:2d3:babe::c1a0
ExecStart=/usr/bin/python3 -u /home/vjt/code/IRC/vjt-claude/bot.py
Restart=always
RestartSec=30
RestartSteps=5
RestartMaxDelaySec=1800
StartLimitBurst=0
StandardOutput=append:/home/vjt/code/IRC/vjt-claude/bot.stdout.log
StandardError=inherit

[Install]
WantedBy=default.target
