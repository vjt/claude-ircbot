bot.log
bot.send
.env
bot.startup
bot.stdout.log

# Trust lists are per-deployment (who YOU trust, on YOUR hosts): untracked.
# Format and an example live in README.
bot.trust
bot.trust.libera
bot.dmallow*

# Libera.Chat instance runtime (2nd bot: same code, own nick/FIFO/logs/env).
.env.libera
bot.send.libera
bot.startup.libera
bot.libera.log
bot.libera.stdout.log

aup_watchdog.log
scrub.log
__pycache__/
*.pyc

# Raw source PNGs from Gemini — only compressed JPEGs under docs/img/ are committed
docs/img/*.png

# Private — channel-specific memory, not for public repo
memory/

# Host-specific Claude Code settings (paths, WebFetch domains)
.claude/settings.local.json

# Reference material (private copies of Azzurra helpers docs, etc.)
refs/

# Scratch / transient workspace crud — dump here, gitignored wholesale
tmp/
# Runtime state (tg poller, orch-send log, watchers) and kept scratch
var/
archive/
*.lock

# Host-local automation helpers (cron scripts + their logs) — not for public repo
tools/

# Leak guard store: recent lines of the reserved channels (confidential)
reserved_recent.tsv
reserved_recent.tsv.tmp

# E2E (e2e_bridge.py): the key, the Olm state and the pins file are per
# instance and belong outside the repo (README); these catch a misplaced one
# under the README's names, the state's interrupted-save temp file included.
*.key
*.pins
*.e2e.json
.*.e2e.json.*
bot.e2e*
.bot.e2e*

